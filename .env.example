# Copia este archivo a ".env" (en la raíz del proyecto) y complétalo.
# NUNCA subas el archivo .env a git.

# development | production   (en production el backend no arranca con secretos de ejemplo)
ENV=development
LOG_LEVEL=INFO

# --- MQTT (EMQX Cloud Serverless: solo TLS en 8883 + usuario/contraseña) ---
MQTT_HOST=tu-instancia.emqxsl.com
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USER=usuario-mqtt
MQTT_PASS=clave-mqtt
# Prefijo de temas, siempre terminado en "/"
MQTT_BASE=mi-prefijo/sala/luz/
# Debe ser distinto al del Arduino. Vacío = paho genera uno aleatorio.
MQTT_CLIENT_ID=

# --- PostgreSQL ---
# Usados por docker compose para crear la base de datos.
# Usa una contraseña sin caracteres especiales de URL (por ejemplo hexadecimal).
POSTGRES_DB=iotluz
POSTGRES_USER=iotluz
POSTGRES_PASSWORD=cambia-esta-clave-de-postgres
# Usada por el backend cuando lo ejecutas fuera de Docker (venv).
# Dentro de Docker, docker-compose la sobrescribe para apuntar al servicio "db".
DATABASE_URL=postgresql+psycopg://iotluz:cambia-esta-clave-de-postgres@localhost:5432/iotluz

INTERVALO_GUARDADO_S=30
ARDUINO_TIMEOUT_S=60

# --- Autenticación ---
ADMIN_USER=admin
# Genera valores largos y aleatorios, por ejemplo:
#   py -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_PASSWORD=cambia-esta-clave
#   py -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia-este-secreto-jwt
JWT_HORAS=12

# Orígenes permitidos por CORS, separados por comas
CORS_ORIGINS=http://localhost:5173
