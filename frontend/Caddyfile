# SITE_ADDRESS: ":80" para servir solo HTTP (local o pruebas),
# o un dominio (p. ej. "luz.midominio.com") para que Caddy obtenga HTTPS automáticamente.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Los navegadores ignoran HSTS servido por HTTP, así que con SITE_ADDRESS=":80" no tiene efecto.
		# Sin includeSubDomains: no sabemos qué más cuelga del dominio.
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# API y WebSocket hacia el backend (uvicorn)
	handle /api/* {
		reverse_proxy {$BACKEND:backend:8000}
	}
	handle /ws {
		reverse_proxy {$BACKEND:backend:8000}
	}

	# Frontend compilado (SPA)
	handle {
		# CSP solo para la SPA (no para /api/*, donde /api/docs carga Swagger desde un CDN).
		# style-src 'unsafe-inline': React y Recharts usan atributos style. connect-src 'self' cubre ws/wss al mismo host.
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
